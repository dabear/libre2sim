diff --git a/LibreSensor/SensorPairing/Libre2NFC.swift b/LibreSensor/SensorPairing/Libre2NFC.swift
new file mode 100644
index 0000000..0b9667e
--- /dev/null
+++ b/LibreSensor/SensorPairing/Libre2NFC.swift
@@ -0,0 +1,48 @@
+//
+//  Libre2NFC.swift
+//  LibreTransmitter
+//
+//  The Libre 2 NFC commands shared by the CoreNFC pairing service and the
+//  Simulator's stand-in, so that they cannot drift apart.
+//
+
+import Foundation
+
+struct NFCCommand {
+    let code: UInt8
+    let parameters: Data
+}
+
+enum Subcommand: UInt8, CustomStringConvertible {
+    case activate = 0x1b
+    case enableStreaming = 0x1e
+    case unknown0x1a = 0x1a
+    case unknown0x1c = 0x1c
+    case unknown0x1d = 0x1d
+    case unknown0x1f = 0x1f
+
+    var description: String {
+        switch self {
+        case .activate: return "activate"
+        case .enableStreaming: return "enable BLE streaming"
+        default: return "[unknown: 0x\(String(format: "%x", rawValue))]"
+        }
+    }
+}
+
+enum Libre2NFC {
+    /// The custom command that enables Bluetooth on a Libre 2. The sensor answers
+    /// with its peripheral MAC address.
+    ///
+    /// The unlockCode could be any 32 bit value. The unlockCode and sensor Uid / patchInfo
+    /// will have also to be provided to the login function when connecting to peripheral.
+    static func enableStreamingCommand(unlockCode: UInt32, patchInfo: Data, sensorUID: Data) -> (code: UInt8, parameters: Data) {
+        let code = Subcommand.enableStreaming
+        let b: [UInt8] = [UInt8(unlockCode & 0xFF), UInt8((unlockCode >> 8) & 0xFF), UInt8((unlockCode >> 16) & 0xFF), UInt8((unlockCode >> 24) & 0xFF)]
+        let y = UInt16(patchInfo[4...5]) ^ UInt16(b[1], b[0])
+
+        let d = Libre2.usefulFunction(id: [UInt8](sensorUID), x: UInt16(code.rawValue), y: y)
+
+        return (code: 0xA1, parameters: Data([code.rawValue]) + b + d)
+    }
+}
